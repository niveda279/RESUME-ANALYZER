# CareerCast Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Flask secret key — used for JWT token signing
# In production, use a strong random value (e.g., python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=careercast_jwt_secret_key_change_in_production

# Flask environment
FLASK_ENV=development

# Optional: Maximum file upload size in megabytes (default: 10)
# MAX_UPLOAD_MB=10

# API URL for Streamlit
API_URL=http://127.0.0.1:5000/api/v2

# MLflow Tracking URI (default local server)
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# CI/CD: Minimum acceptable model accuracy threshold
MODEL_ACCURACY_THRESHOLD=0.80
