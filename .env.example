# CareerCast Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Flask secret key — used for JWT token signing
# In production, use a strong random value (e.g., python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=careercast_jwt_secret_key_change_in_production

# Flask environment
FLASK_ENV=development

# Optional: Maximum file upload size in megabytes (default: 10)
# MAX_UPLOAD_MB=10
